# WordPress AI SEO Autopilot Configuration

# 1. Google Gemini API Key (From Google AI Studio or Google Cloud Console)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. WordPress Site Details
WP_SITE_URL=https://yourwebsite.com

# 3. WordPress Credentials (Use Application Password, not your login password)
WP_USERNAME=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
